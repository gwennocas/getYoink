{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "getYoink",
  "version": "0.1.2",
  "identifier": "app.getyoink.mobile",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "getYoink — pega e leva.", "width": 1080, "height": 900, "minWidth": 360, "minHeight": 640, "backgroundColor": "#1d2021" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "android": { "minSdkVersion": 29 } }
}
